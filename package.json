{
	"name": "rev-dash",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"dotenv": "^17.4.2",
			"zod": "^4.4.3",
			"typescript": "^6.0.3",
			"@types/node": "^22.20.1",
			"lucide-react": "^1.27.0",
			"next-themes": "^0.4.6",
			"react": "^19.2.8",
			"react-dom": "^19.2.8",
			"sonner": "^2.0.7",
			"@types/react": "^19.2.17",
			"@types/react-dom": "^19.2.3",
			"tailwindcss": "^4.3.3",
			"alchemy": "^0.93.12"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"dev:web": "turbo run dev -F web",
		"deploy": "turbo --env-mode=loose run deploy -F @rev-dash/infra",
		"destroy": "turbo run destroy -F @rev-dash/infra",
		"check": "biome check --write ."
	},
	"dependencies": {
		"@rev-dash/env": "workspace:*",
		"dotenv": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.6",
		"@cloudflare/workers-types": "^5.20260728.1",
		"@rev-dash/config": "workspace:*",
		"@types/node": "catalog:",
		"turbo": "^2.10.7",
		"typescript": "catalog:"
	},
	"packageManager": "bun@1.3.14"
}
